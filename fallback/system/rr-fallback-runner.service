# RootRecord AWS fallback: one runtime tick. Desk-canonical (US-Mainland-One fallback/system/), deployed by deploy-aws-fallback.sh.
[Unit]
Description=RootRecord AWS fallback tick (desk_watch, relay_buffer, status, retention)
After=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
Nice=10
IOSchedulingClass=idle
MemoryMax=64M
TimeoutStartSec=120
NoNewPrivileges=yes
ExecStart=/usr/bin/python3 /home/ubuntu/rootrecord/fallback/app/rr_fallback_tick.py
