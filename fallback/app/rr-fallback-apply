#!/usr/bin/python3
"""rr-fallback-apply: ROOT. Applies service-type fallback flags to systemd (installed at /usr/local/sbin).

INFO (future agents): must read
- Desk-canonical (US-Mainland-Server fallback/app/rr-fallback-apply). The deploy script installs it root:root 0755.
- The id -> unit MAP is hard-coded HERE (root-owned). The ubuntu-writable flags dir only supplies "1"/"0",
  so a flag can never name a unit, a path or a command.
- LOCKED ids (tunnel) are never stopped by a flag. UNMANAGED ids are ignored:
  globe_feed_8787 (decision pending), globe_ingest (cron), public_ip_notify (boot oneshot).
- A missing flag file means "no opinion" (nothing is done). --dry-run prints the plan only.
- Triggered by rr-fallback-apply.path (flags/ modified) and rr-fallback-apply.timer (15-min reconcile).
"""
import json
import os
import stat
import subprocess
import sys
import time

FLAGS = "/home/ubuntu/rootrecord/fallback/flags"
MAP = {
    "globe_web": "network-globe-web.service",
    "globe_history": "network-globe-connection-history.service",
    "github_poller": "github-poller.service",
    "legacy_poller": "rr-rootserver-poller.service",
}
LOCKED = {"tunnel": "cloudflared-network-globe.service"}


def flag(fid):
    try:
        fd = os.open(os.path.join(FLAGS, fid), os.O_RDONLY | os.O_NOFOLLOW)
    except OSError:
        return None
    try:
        if not stat.S_ISREG(os.fstat(fd).st_mode):
            return None
        v = os.read(fd, 8).decode(errors="ignore").strip()
    finally:
        os.close(fd)
    return {"1": True, "0": False}.get(v)


def sc(*a):
    return subprocess.run(["systemctl", *a], capture_output=True, text=True).stdout.strip()


def main():
    dry = "--dry-run" in sys.argv
    st = os.lstat(FLAGS) if os.path.lexists(FLAGS) else None
    if st is None or not stat.S_ISDIR(st.st_mode):
        print("flags dir missing or not a directory; nothing to do"); return 0
    plan, report = [], {}
    for fid, unit in MAP.items():
        want = flag(fid)
        active, enabled = sc("is-active", unit), sc("is-enabled", unit)
        report[fid] = {"unit": unit, "flag": want, "active": active, "enabled": enabled}
        if want is True and (active != "active" or enabled != "enabled"):
            plan.append((fid, unit, "enable --now"))
        elif want is False and (active in ("active", "activating") or enabled == "enabled"):
            plan.append((fid, unit, "disable --now"))
    for fid, unit in LOCKED.items():
        want = flag(fid)
        report[fid] = {"unit": unit, "flag": want, "active": sc("is-active", unit), "locked": True}
        if want is False:
            print(f"refused: {fid} is locked on (flag=0 ignored)")
    for fid, unit, act in plan:
        print(("DRY-RUN would " if dry else "apply: ") + f"systemctl {act} {unit}  ({fid})")
        if not dry:
            r = subprocess.run(["systemctl", *act.split(), unit], capture_output=True, text=True)
            report[fid]["applied"] = act if r.returncode == 0 else f"FAILED rc={r.returncode}"
    if not plan:
        print("in sync: no changes")
    if not dry:
        os.makedirs("/run/rr-fallback", exist_ok=True)
        with open("/run/rr-fallback/apply.json", "w") as f:
            json.dump({"ts": int(time.time()), "plan": [p[2] + " " + p[1] for p in plan], "units": report}, f)
        os.chmod("/run/rr-fallback/apply.json", 0o644)
    return 0


if __name__ == "__main__":
    sys.exit(main())
