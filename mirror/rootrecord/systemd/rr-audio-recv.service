[Unit]
Description=RootRecord audio Current.* receiver (from local current_ wavs)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/rootrecord
Environment=RR_ROOT=/home/ubuntu/rootrecord
Environment=TZ=Pacific/Honolulu
ExecStart=/home/ubuntu/rootrecord/venv/bin/python /home/ubuntu/rootrecord/bin/audio_recv.py
Restart=always
RestartSec=5
StandardOutput=append:/home/ubuntu/rootrecord/logs/audio_recv.log
StandardError=append:/home/ubuntu/rootrecord/logs/audio_recv.log

[Install]
WantedBy=multi-user.target
