[Unit]
Description=RootRecord Icecast radio stream (ffmpeg → Icecast)
After=network-online.target rr-icecast.service
Wants=network-online.target rr-icecast.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/rootrecord
Environment=RR_ROOT=/home/ubuntu/rootrecord
Environment=TZ=Pacific/Honolulu
Environment=RR_RADIO_DUCK_VOL=0.18
Environment=RR_RADIO_VOICE_VOL=2.2
Environment=RR_RADIO_POLL_SEC=0.35
ExecStart=/bin/bash /home/ubuntu/rootrecord/bin/radio_stream.sh
Restart=always
RestartSec=5
StandardOutput=append:/home/ubuntu/rootrecord/logs/radio.log
StandardError=append:/home/ubuntu/rootrecord/logs/radio.log

[Install]
WantedBy=multi-user.target
