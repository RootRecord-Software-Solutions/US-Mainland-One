[Unit]
Description=RootRecord chronological drop-in poller supervisor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/rootrecord
Environment=RR_ROOT=/home/ubuntu/rootrecord
Environment=TZ=Pacific/Honolulu
Environment=PYTHONPATH=/home/ubuntu/rootrecord/bin
ExecStart=/home/ubuntu/rootrecord/venv/bin/python /home/ubuntu/rootrecord/bin/dropin_supervisor.py
Restart=always
RestartSec=5
StandardOutput=append:/home/ubuntu/rootrecord/logs/dropins.log
StandardError=append:/home/ubuntu/rootrecord/logs/dropins.log

[Install]
WantedBy=multi-user.target
