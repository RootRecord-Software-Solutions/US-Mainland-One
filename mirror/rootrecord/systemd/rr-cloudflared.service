[Unit]
Description=RootRecord Cloudflare tunnel (radio Icecast)
After=network-online.target rr-icecast.service
Wants=network-online.target rr-icecast.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/rootrecord
Environment=RR_ROOT=/home/ubuntu/rootrecord
Environment=TZ=Pacific/Honolulu
ExecStart=/bin/bash /home/ubuntu/rootrecord/bin/cloudflared_radio.sh
Restart=always
RestartSec=10
StandardOutput=append:/home/ubuntu/rootrecord/logs/cloudflared.log
StandardError=append:/home/ubuntu/rootrecord/logs/cloudflared.log

[Install]
WantedBy=multi-user.target
