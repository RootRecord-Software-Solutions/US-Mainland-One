[Unit]
Description=RootRecord hurricane / tropical poller
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/rootrecord
Environment=RR_ROOT=/home/ubuntu/rootrecord
Environment=TZ=Pacific/Honolulu
ExecStart=/home/ubuntu/rootrecord/venv/bin/python /home/ubuntu/rootrecord/bin/hurricane_poll.py
Restart=always
RestartSec=5
StandardOutput=append:/home/ubuntu/rootrecord/logs/hurricane.log
StandardError=append:/home/ubuntu/rootrecord/logs/hurricane.log

[Install]
WantedBy=multi-user.target
