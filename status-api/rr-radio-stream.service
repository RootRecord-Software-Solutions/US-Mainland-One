[Unit]
Description=Root Record radio station (one mix, one encoder)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/rootrecord-radio
Environment=HOST=127.0.0.1
Environment=PORT=8092
Environment=RADIO_DIR=/home/ubuntu/rootrecord-radio/audio
Environment=RADIO_REPORTS_DIR=/home/ubuntu/rootrecord-radio/audio/reports
Environment=RADIO_HEARTBEAT=/home/ubuntu/rootrecord-radio/state/heartbeat
Environment=RADIO_DEPLOY_PENDING=/home/ubuntu/rootrecord-radio/deploy-pending
ExecStart=/home/ubuntu/rootrecord-radio/radio-run.sh
Restart=on-failure
RestartSec=2
KillMode=mixed
TimeoutStopSec=5

[Install]
WantedBy=multi-user.target
