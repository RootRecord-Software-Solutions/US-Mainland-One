[Unit]
Description=Root Record Mainland 1s poller
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/ubuntu
EnvironmentFile=-/home/ubuntu/.env
ExecStart=/usr/bin/python3 /home/ubuntu/automations/scripts/rootserver_poller.py
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
